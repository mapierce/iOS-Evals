# Copy to .env and fill in. .env is gitignored; this file is not.
#
#     cp .env.example .env
#
# Every value here is read from the environment at run time. Nothing in this
# repo writes a key to disk, and no key is ever recorded in results/.

# Required. Single-endpoint gateway used for all model generation, so every
# model is called through one identical code path. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional attribution headers sent with each request.
OPENROUTER_REFERER=
OPENROUTER_TITLE=ios-evals
